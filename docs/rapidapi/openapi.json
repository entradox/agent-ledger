            "default": 0
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "agent_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Secret"
          },
          "workspace_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Key"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "rail"
        ],
