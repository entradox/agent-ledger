            "title": "Agent Id"
          },
          "monthly_cents": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Monthly Cents"
          },
          "daily_cents": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Daily Cents",
            "default": 0
          },
          "monthly_tokens": {
            "type": "integer",
            "minimum": 0.0,
