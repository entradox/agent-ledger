__pycache__/
*.pyc
.env
*.env
.DS_Store
logs/
*.db
*.sqlite*
.pytest_cache/
counts.jsonl
customers.jsonl
tier_mismatch.jsonl
grant_failures.jsonl
metrics.jsonl

# Data-dir runtime state. metrics.py writes DATA_DIR/metrics.jsonl on every
# event and nothing ignored it, so any commit run from the data dir would sweep
# a live revenue counter into git — a derived artifact that also leaks the
# customer funnel. (Muse's fix contract #5, pre-existing hazard note.)
.claude-build-prompt*
.claude/

# Journey-sweep run artifacts. The harness writes journey-sweep-<date>.log/.json on every
# run, so committing them means every sweep dirties the tree with a file whose NAME carries
# a stale date — the first run after midnight would also leave an untracked new file behind.
# They are run dumps, not evidence worth versioning: the sweep is re-runnable on demand and
# its verdict is in the exit code and the JSON. (D-1404.)
journey-sweep-*.log
journey-sweep-*.json

# packaging build artifacts (never commit derived files)
*.egg-info/
build/
dist/

# npm
node_modules/
*.tgz
npm/.npmrc
